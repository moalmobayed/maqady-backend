# Maqady backend environment (design §14.5). Copy to .env for local runs; never commit .env.
# Real environments (Render, CI) set these as environment variables, which always win over .env.
# Empty values count as unset. No secrets belong in this file.

# --- Read and validated today -------------------------------------------------------------

# Postgres connection URL. Local: Docker Compose or `npm run db:local`.
# Supabase: the session pooler URL (port 5432); see README "Supabase".
DATABASE_URL=postgres://postgres:postgres@localhost:5432/maqady_dev
# Schema that holds every table (first on the search_path).
DB_SCHEMA=maqady
# Comma-separated browser origins allowed by CORS: scheme://host[:port], no trailing slash.
CORS_ORIGINS=http://localhost:5173
# HTTP port (Render sets PORT itself). Default 3000.
PORT=3000
# fatal | error | warn | info | debug | trace | silent. Default info.
LOG_LEVEL=info

# Access-token signing secrets, one per audience (design 10.2): base64 of at least 32 bytes, and
# the two must differ. Generate each with: openssl rand -base64 32
JWT_SECRET_CUSTOMER=
JWT_SECRET_STAFF=
# Encrypts stored idempotency responses (AES-256-GCM): base64 of exactly 32 bytes.
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# After a rotation, the old key: it only decrypts. Leave empty otherwise.
DATA_ENCRYPTION_PREVIOUS_KEY=

# Rate limits (design 10.6), <count>/<window> with the window in s, m or h. Empty = the default.
RATE_LIMIT_DEFAULT=          # 300/1m, every route, per route, per signed-in customer else IP
RATE_LIMIT_SIGN_IN_EMAIL=    # 5/1m, per IP and email
RATE_LIMIT_SIGN_IN_IP=       # 20/1m
RATE_LIMIT_REGISTRATION_IP=  # 5/1h
RATE_LIMIT_EMAIL_REQUEST_EMAIL= # 3/1h, forgot password and resend verification, per email
RATE_LIMIT_EMAIL_REQUEST_IP= # 20/1h
RATE_LIMIT_VERIFICATION_RESEND_CUSTOMER= # 3/1h, resend verification, per signed-in customer
RATE_LIMIT_HOLD_IP=          # 30/10m
RATE_LIMIT_HOLD_CUSTOMER=    # 10/10m, per signed-in customer
RATE_LIMIT_PAYMENT=          # 10/5m, per booking
RATE_LIMIT_TICKET_EMAIL=     # 3/1h, per booking
RATE_LIMIT_SEARCH=           # 60/1m

# The live seat map (design 10.6, 12): open WebSocket connections per IP address, and showtimes
# one connection may subscribe to. Empty = the default.
WS_CONNECTIONS_PER_IP=           # 20
WS_SUBSCRIPTIONS_PER_CONNECTION= # 3

# Links in emails point at the frontend: http(s)://host[:port][/path], no query; a trailing / is dropped.
FRONTEND_BASE_URL=http://localhost:5173

# How email leaves (ADR 0004): simulated (recorded as sent, nothing leaves; local runs and CI) or
# resend. Only one environment may send through a Resend team, because message ids are Resend's
# idempotency keys and two databases' ids would collide; every other environment stays simulated.
EMAIL_DRIVER=simulated
# Required with EMAIL_DRIVER=resend. EMAIL_FROM is an address on the domain verified in Resend,
# such as tickets@maqady.example or "Maqady <tickets@maqady.example>".
RESEND_API_KEY=
EMAIL_FROM=

# Where uploaded images go (design 9): supabase (every deployed environment) or local
# (development and tests). Required, no default.
STORAGE_DRIVER=local
# For supabase: the project URL (https://<ref>.supabase.co, no trailing slash) and the service
# role key. The key stays on the server only. The bucket must exist and be public.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=media
# For local: the directory that holds the files (created on the first upload) and the URL the
# app serves it at. Defaults: .media and http://localhost:<PORT>/media.
LOCAL_STORAGE_DIR=.media
LOCAL_STORAGE_PUBLIC_URL=

# --- Validated by the units that start using them -------------------------------------------

# Signs ticket QR codes. Generate with: openssl rand -base64 32
QR_SIGNING_KEY=

# --- npm run admin:create only (never read by the service) -----------------------------------

# The first admin. Set for the one run, then remove. The password needs 8 to 128 characters and
# a digit; it is never printed or logged.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- npm run seed only (development databases) ----------------------------------------------

# The seed admin's password; empty means the development default documented in the README.
SEED_ADMIN_PASSWORD=

# --- Tests only ------------------------------------------------------------------------------

# Integration tests migrate this database from zero; its name must end in _test.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/maqady_test
